new file mode 100644
index 0000000..749ccc4
--- /dev/null
+++ b/packages/coding-agent/test/transcript-container.test.ts
@@ -0,0 +1,134 @@
+import type { Component } from "@earendil-works/pi-tui";
+import { describe, expect, it } from "vitest";
+import type { TranscriptBlock } from "../src/core/extensions/types.ts";
+import { AssistantMessageComponent } from "../src/modes/interactive/components/assistant-message.ts";
+import { SkillInvocationMessageComponent } from "../src/modes/interactive/components/skill-invocation-message.ts";
+import { TranscriptContainer } from "../src/modes/interactive/components/transcript-container.ts";
+import { UserMessageComponent } from "../src/modes/interactive/components/user-message.ts";
+import { getMarkdownTheme, initTheme } from "../src/modes/interactive/theme/theme.ts";
+
+initTheme("dark");
+
+class Plain implements Component {
+	private readonly lines: string[];
+
+	constructor(lines: string[]) {
+		this.lines = lines;
+	}
+
+	render(): string[] {
+		return [...this.lines];
+	}
+
+	invalidate(): void {}
+}
+
+class Block implements Component {
+	private readonly block: TranscriptBlock;
+	private readonly lines: string[];
+
+	constructor(block: TranscriptBlock, lines: string[]) {
+		this.block = block;
+		this.lines = lines;
+	}
+
+	getTranscriptBlock(): TranscriptBlock {
+		return this.block;
+	}
+
+	render(): string[] {
+		return [...this.lines];
+	}
+
+	invalidate(): void {}
+}
+
+describe("TranscriptContainer", () => {
+	it("treats skill invocations as user transcript blocks", () => {
+		expect(SkillInvocationMessageComponent.prototype.getTranscriptBlock()).toEqual({ kind: "user" });
+	});
+
+	it("keeps user padding separate from the transcript gap", () => {
+		const user = new UserMessageComponent("request", getMarkdownTheme(), 1);
+		const assistant = new AssistantMessageComponent(undefined, true, getMarkdownTheme(), "", 1);
+		assistant.updateContent({
+			role: "assistant",
+			content: [
+				{ type: "thinking", thinking: "hidden" },
+				{ type: "text", text: "answer" },
+			],
+			stopReason: "stop",
+		} as never);
+
+		expect(user.render(80)).toHaveLength(3);
+		expect(assistant.render(80)).toHaveLength(1);
+
+		const transcript = new TranscriptContainer();
+		transcript.addChild(user);
+		transcript.addChild(assistant);
+		expect(transcript.render(80)).toHaveLength(5);
+		expect(transcript.render(80)[3]).toBe("");
+	});
+
+	it("owns the exact gap between visible blocks", () => {
+		const transcript = new TranscriptContainer();
+		transcript.setPresentation({ gap: 1 });
+		transcript.addChild(new Block({ kind: "user" }, ["user"]));
+		transcript.addChild(new Block({ kind: "assistant" }, ["answer"]));
+
+		expect(transcript.render(80)).toEqual(["user", "", "answer"]);
+
+		transcript.setPresentation({ gap: 2 });
+		expect(transcript.render(80)).toEqual(["user", "", "", "answer"]);
+	});
+
+	it("preserves non-semantic layout and spaces the following block", () => {
+		const transcript = new TranscriptContainer();
+		transcript.addChild(new Plain(["border"]));
+		transcript.addChild(new Plain(["content"]));
+		transcript.addChild(new Block({ kind: "user" }, ["request"]));
+
+		expect(transcript.render(80)).toEqual(["border", "content", "", "request"]);
+	});
+
+	it("sanitizes invalid and excessive gaps", () => {
+		const transcript = new TranscriptContainer();
+		transcript.setPresentation({ gap: Number.POSITIVE_INFINITY });
+		transcript.addChild(new Block({ kind: "user" }, ["user"]));
+		transcript.addChild(new Block({ kind: "assistant" }, ["answer"]));
+
+		expect(transcript.render(80)).toEqual(["user", "", "answer"]);
+		transcript.setPresentation({ gap: 100 });
+		expect(transcript.render(80)).toHaveLength(12);
+	});
+
+	it("does not leave a gap for hidden or empty blocks", () => {
+		const transcript = new TranscriptContainer();
+		transcript.setPresentation({
+			gap: 1,
+			isVisible: (block) => block.kind !== "tool",
