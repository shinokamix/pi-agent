diff --git a/packages/coding-agent/src/modes/interactive/components/transcript-container.ts b/packages/coding-agent/src/modes/interactive/components/transcript-container.ts
new file mode 100644
index 0000000..a9df259
--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/components/transcript-container.ts
@@ -0,0 +1,69 @@
+import type { Component } from "@earendil-works/pi-tui";
+import { Container } from "@earendil-works/pi-tui";
+import type { TranscriptBlock, TranscriptPresentation } from "../../../core/extensions/types.ts";
+
+type TranscriptBlockComponent = Component & {
+	getTranscriptBlock(): TranscriptBlock;
+};
+
+function isTranscriptBlockComponent(component: Component): component is TranscriptBlockComponent {
+	return (
+		typeof component === "object" &&
+		component !== null &&
+		"getTranscriptBlock" in component &&
+		typeof component.getTranscriptBlock === "function"
+	);
+}
+
+/**
+ * Vertical transcript layout. Semantic transcript blocks use centralized
+ * spacing and presentation; other components retain their existing layout.
+ */
+export class TranscriptContainer extends Container {
+	private presentation: TranscriptPresentation | undefined;
+
+	setPresentation(presentation?: TranscriptPresentation): void {
+		this.presentation = presentation;
+	}
+
+	override render(width: number): string[] {
+		const lines: string[] = [];
+		let hasRenderedContent = false;
+		const requestedGap = this.presentation?.gap ?? 1;
+		const gap = Number.isFinite(requestedGap) ? Math.max(0, Math.min(10, Math.floor(requestedGap))) : 1;
+
+		for (const child of this.children) {
+			if (!isTranscriptBlockComponent(child)) {
+				const childLines = child.render(width);
+				lines.push(...childLines);
+				hasRenderedContent ||= childLines.length > 0;
+				continue;
+			}
+
+			const block = child.getTranscriptBlock();
+			try {
+				if (this.presentation?.isVisible?.(block) === false) continue;
+			} catch {
+				// Presentation callbacks must never make the transcript disappear.
+			}
+
+			const renderedLines = child.render(width);
+			if (renderedLines.length === 0) continue;
+
+			let childLines = renderedLines;
+			try {
+				childLines = this.presentation?.decorate?.(block, [...renderedLines], width) ?? renderedLines;
+			} catch {
+				// Keep the undecorated block if an extension decorator fails.
+				childLines = renderedLines;
+			}
+			if (childLines.length === 0) continue;
+
+			if (hasRenderedContent) lines.push(...Array.from({ length: gap }, () => ""));
+			lines.push(...childLines);
+			hasRenderedContent = true;
+		}
+
+		return lines;
+	}
+}
