{
  "name": "@shinokamix/pi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Pi coding agent setup",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinokamix/pi-agent.git"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "node --experimental-transform-types --test extensions/calm-mode/*.test.ts extensions/pretty-response/*.test.ts extensions/researcher/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.9",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./extensions/calm-mode",
      "./extensions/pretty-response",
      "./extensions/researcher"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
