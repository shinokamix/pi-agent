{
	"name": "@shinokamix/pi-agent",
	"version": "0.1.0",
	"private": true,
	"description": "Portable Pi extensions, skills, and prompts",
	"type": "module",
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	},
	"files": [
		"agents",
		"config",
		"prompts",
		"scripts/link-config.mjs",
		"skills"
	],
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shinokamix/pi-agent.git"
	},
	"scripts": {
		"check": "npm run lint && npm run format:check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"link:config": "node scripts/link-config.mjs",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.84.4",
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@earendil-works/pi-tui": "^0.84.2",
		"@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
		"@eslint/js": "10.0.1",
		"eslint": "10.8.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-regexp": "3.2.0",
		"eslint-plugin-security": "4.0.1",
		"eslint-plugin-sonarjs": "4.2.0",
		"eslint-plugin-unicorn": "73.0.0",
		"globals": "17.11.0",
		"lefthook": "2.1.10",
		"prettier": "3.9.6",
		"typebox": "^1.3.9"
	},
	"pi": {
		"extensions": [
			"./node_modules/pi-multi-account/index.ts",
			"./node_modules/@tintinweb/pi-subagents/src/index.ts",
			"./node_modules/pi-web-access/index.ts"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		]
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.14.0",
		"@tintinweb/pi-subagents": "0.19.0",
		"pi-multi-account": "1.20.0",
		"pi-web-access": "0.27.0"
	},
	"bundledDependencies": [
		"@bufbuild/protobuf",
		"@tintinweb/pi-subagents",
		"pi-multi-account",
		"pi-web-access"
	]
}
