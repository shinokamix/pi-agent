{
  "name": "@shinokamix/pi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Pi extensions, skills, and prompts",
  "type": "module",
  "files": [
    "extensions/minimal-footer",
    "extensions/researcher/index.ts",
    "extensions/researcher/README.md",
    "skills",
    "prompts"
  ],
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinokamix/pi-agent.git"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "node --experimental-transform-types --test extensions/researcher/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@narumitw/pi-usage": "0.52.0"
  },
  "bundledDependencies": [
    "@narumitw/pi-usage"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.9",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./extensions/minimal-footer",
      "./extensions/researcher",
      "./node_modules/@narumitw/pi-usage/src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
